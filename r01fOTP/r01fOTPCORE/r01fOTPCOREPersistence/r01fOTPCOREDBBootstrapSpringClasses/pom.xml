<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" 
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

<!-- ====================================================================== -->
<!-- PARENT                                                                 -->
<!-- ====================================================================== -->
	<parent>
		<groupId>r01.fabric.security.otp.core.persistence</groupId>
		<artifactId>r01fOTPCOREPersistence</artifactId>
		<version>${revision}</version>
	</parent>

<!-- ====================================================================== -->
<!-- ARTIFACT                                                               -->
<!-- ====================================================================== -->
	<name>r01fOTPCOREDBBootstrapSpringClasses</name>
	<artifactId>r01fOTPCOREDBBootstrapSpringClasses</artifactId>

<!-- ====================================================================== -->
<!-- DEPENDENCIES                                                           -->
<!-- ====================================================================== -->
	<dependencies>
		<!-- ///////////////////////////////////////// -->
		<!-- R01F: Security OTP API                   -->
		<!-- ///////////////////////////////////////// -->
		<dependency>
		   <groupId>r01.fabric.security.otp.core.persistence</groupId>
			<artifactId>r01fOTPCOREDBPersistenceClasses</artifactId>
			<version>${revision}</version>
		</dependency>
		<!-- ///////////////////////////////////////// -->
		<!-- R01F: DBPersistence                       -->
		<!-- ///////////////////////////////////////// -->
		<dependency>
			<groupId>r01.fabric.businessservices.core.persistence.db</groupId>
			<artifactId>r01fDBPersistenceClasses</artifactId>
			<version>${r01f.businessservices.version}</version>
		</dependency>			
		<dependency>
			<groupId>r01.fabric.businessservices.core.persistence.search</groupId>
			<artifactId>r01fSearchDBClasses</artifactId>
			<version>${r01f.businessservices.version}</version>
		</dependency>
		
		<dependency>
			<groupId>r01.fabric.base.eventbus</groupId>
			<artifactId>r01fSpringEventBusClasses</artifactId>
			<version>${r01f.base.version}</version>
		</dependency>
	  
	  	<!-- ///////////////////////////////////////// -->
		<!-- R01F: Spring                              -->
		<!-- ///////////////////////////////////////// -->
		<dependency>
			 <groupId>r01.fabric.base.spring.boot</groupId>
			 <artifactId>r01fSpringBootStarterDataJPAClasses</artifactId>
			<version>${r01f.base.version}</version>
	    </dependency>
	    
	    <dependency>
			<groupId>r01.fabric.businessservices.spring</groupId>
			<artifactId>r01fBusinessServicesSpringCoreClasses</artifactId>
		    <version>${r01f.businessservices.version}</version>
		</dependency>
		
		<dependency>
			<groupId>r01.fabric.businessservices.spring</groupId>
			<artifactId>r01fBusinessServicesSpringCorePersistenceDBClasses</artifactId>
			 <version>${r01f.businessservices.version}</version>
		</dependency>
		
	</dependencies>
	
<!-- ====================================================================== -->
<!-- BUILD                                                                  -->
<!-- ====================================================================== -->
	<build>
		<pluginManagement>
			<plugins>
				<!--
				ECLIPSE (see main pom.xml for further info) ===================
				This plugin has NO effects in maven build:
					m2e ONLY runs some 'standard' goals of the maven pom.xml since the aim of m2e is NOT to be a complete CI tool
					... in order to include 'non-standard' goals in m2e execution and avoid [plugin execution not covered by the eclipse m2e plugin project build lifecycle mapping]
						the 'non-standard' plugin MUST be explicitly included in m2e execution
				-->
				<plugin>
					<groupId>org.eclipse.m2e</groupId>
					<artifactId>lifecycle-mapping</artifactId>
					<version>1.0.0</version>
					<configuration> 
						<lifecycleMappingMetadata>
							<pluginExecutions>
								<!-- flatten plugin -->
								<pluginExecution>
									<pluginExecutionFilter>
										<groupId>org.codehaus.mojo</groupId>
										<artifactId>flatten-maven-plugin</artifactId>
										<versionRange>[1.1.0,)</versionRange>
										<goals>
											<goal>flatten</goal>
										</goals>
									</pluginExecutionFilter>
									<action>
										<ignore></ignore>
									</action>
								</pluginExecution>
							</pluginExecutions>
						</lifecycleMappingMetadata>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>
</project>
