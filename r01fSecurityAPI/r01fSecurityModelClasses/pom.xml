<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" 
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

<!-- ====================================================================== -->
<!-- PARENT                                                                 -->
<!-- ====================================================================== -->
	<parent>
		<groupId>r01.fabric.security.api</groupId>
		<artifactId>r01fSecurityAPI</artifactId>
		<version>${revision}</version>
	</parent>

<!-- ====================================================================== -->
<!-- ARTIFACT                                                               -->
<!-- ====================================================================== -->
	<name>r01fSecurityModelClasses</name>
	<artifactId>r01fSecurityModelClasses</artifactId>

<!-- ====================================================================== -->
<!-- DEPENDENCIES                                                           -->
<!-- ====================================================================== -->
	<dependencies>
		<!-- ///////////////////////////////////////// -->
		<!--  R01F: Base Model Classes                 -->
		<!-- ///////////////////////////////////////// -->
		<dependency>
			<groupId>r01.fabric.base</groupId>
			<artifactId>r01fModelClasses</artifactId>
			<version>${r01f.base.version}</version>
		</dependency>
				
		<!-- ///////////////////////////////////////// -->
		<!-- EventBus Interface Classes                -->
		<!-- ///////////////////////////////////////// -->
		<dependency>
			<groupId>r01.fabric.base.eventbus</groupId>
			<artifactId>r01fEventBusClasses</artifactId>
	      	<version>${r01f.base.version}</version>
		</dependency>
		
		<!-- ///////////////////////////////////////// -->
		<!--  CRYPTO                                   -->
		<!-- ///////////////////////////////////////// -->
		<!-- 
			this library SHOULD NOT BE HERE!!!!!
			the only reason why this lib is here is because of the 
			r01f.model.security.login.apikey.ApiKeyPairBuilder type
			... this util SHOULD be mover to [r01fSecurityAPIClasses]
			and the [r01fCryptoClasses] dep should be also moved there
			(maybe refactor the package where [ApiKeyPairBuilder] is located)
		-->
		<dependency>
			<groupId>r01.fabric.security</groupId>
			<artifactId>r01fCryptoClasses</artifactId>
			<version>${revision}</version>
		</dependency>
	</dependencies>

<!-- ====================================================================== -->
<!-- BUILD                                                                  -->
<!-- ====================================================================== -->
	<build>
		<pluginManagement>
			<plugins>
				<!--
				ECLIPSE (see main pom.xml for further info) ===================
				This plugin has NO effects in maven build:
					m2e ONLY runs some 'standard' goals of the maven pom.xml since the aim of m2e is NOT to be a complete CI tool
					... in order to include 'non-standard' goals in m2e execution and avoid [plugin execution not covered by the eclipse m2e plugin project build lifecycle mapping]
						the 'non-standard' plugin MUST be explicitly included in m2e execution
				-->
				<plugin>
					<groupId>org.eclipse.m2e</groupId>
					<artifactId>lifecycle-mapping</artifactId>
					<version>1.0.0</version>
					<configuration>
						<lifecycleMappingMetadata>
							<pluginExecutions>
								<!-- flatten plugin -->
								<pluginExecution>
									<pluginExecutionFilter>
										<groupId>org.codehaus.mojo</groupId>
										<artifactId>flatten-maven-plugin</artifactId>
										<versionRange>[1.1.0,)</versionRange>
										<goals>
											<goal>flatten</goal>
										</goals>
									</pluginExecutionFilter>
									<action>
										<ignore></ignore>
									</action>
								</pluginExecution>
							</pluginExecutions>
						</lifecycleMappingMetadata>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>
</project>
