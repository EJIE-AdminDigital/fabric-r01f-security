<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- ====================================================================== -->
	<!-- PARENT																 -->
	<!-- ====================================================================== -->
	<parent>
		<groupId>r01.fabric.security</groupId>
		<artifactId>r01fSecurity</artifactId>
		<version>${revision}</version>
	</parent>

	<!-- ====================================================================== -->
	<!-- ARTIFACT															   -->
	<!-- ====================================================================== -->
	<name>r01fCryptoClasses</name>
	<artifactId>r01fCryptoClasses</artifactId>

	<!-- ====================================================================== -->
	<!-- DEPENDENCIES														   -->
	<!-- ====================================================================== -->
	<dependencies>

		<dependency>
			<groupId>r01.fabric.base</groupId>
			<artifactId>r01fIOClasses</artifactId>
			<version>${r01f.base.version}</version>
		</dependency>
		<!-- ///////////////////////////////////////// -->
		<!-- R01: HttpClient						   -->
		<!-- ///////////////////////////////////////// -->
		<dependency>
			<groupId>r01.fabric.base.httpclient</groupId>
			<artifactId>r01fHttpClientClasses</artifactId>
			<version>${r01f.base.version}</version>
			<exclusions>
				<exclusion>
					<groupId>org.apache.httpcomponents.client5</groupId>
					<artifactId>httpclient5</artifactId>
				</exclusion>
				  <exclusion>
					<groupId>org.apache.httpcomponents.core5</groupId>
					<artifactId>httpcore5</artifactId>
				</exclusion>
				<exclusion>
					<groupId>org.apache.httpcomponents</groupId>
					<artifactId>httpmime</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<!-- ///////////////////////////////////////// -->
		<!--  Cryptography							   -->
		<!-- ///////////////////////////////////////// -->
		<!-- By the moment, this version is needed. --> 
		<!-- With other versions cryptography doesn't work properly. -->
		<!-- Pending to update to newer versions. -->
		<dependency>
			<groupId>org.bouncycastle</groupId>
			<artifactId>bcprov-jdk15on</artifactId>
			<version>1.68</version>
		</dependency>
		<dependency>
			<groupId>org.bouncycastle</groupId>
			<artifactId>bcpkix-jdk15on</artifactId>
			<version>1.54</version>
		</dependency>
		<!-- ///////////////////////////////////////// -->
		<!-- used to create apache htpasswd            -->
		<!-- ///////////////////////////////////////// -->
		<dependency>
			<groupId>commons-codec</groupId>
			<artifactId>commons-codec</artifactId>
			<version>1.17.1</version>
		</dependency>		
	</dependencies>

</project>
