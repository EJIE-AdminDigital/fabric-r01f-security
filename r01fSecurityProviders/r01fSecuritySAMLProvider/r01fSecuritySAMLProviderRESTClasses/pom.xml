<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- ====================================================================== -->
	<!-- PROPERTIES                                                             -->
	<!-- ====================================================================== -->
	<properties>
		<!-- Dependencies versions -->
		<!-- opensaml 4.0.1 requires JDK > 11 (for jdk8 use 3.4.6) -->
		<opensaml.version>4.0.1</opensaml.version>
	</properties>

	<!-- ====================================================================== -->
	<!-- PARENT                                                                 -->
	<!-- ====================================================================== -->
	<parent>
		<groupId>r01.fabric.security.providers.saml</groupId>
		<artifactId>r01fSecuritySAMLProvider</artifactId>
		<version>${revision}</version>
	</parent>
	<!-- ====================================================================== -->
	<!-- ARTIFACT                                                               -->
	<!-- ====================================================================== -->
	<name>r01fSecuritySAMLProviderRESTClasses</name>
	<artifactId>r01fSecuritySAMLProviderRESTClasses</artifactId>

	<!-- ====================================================================== -->
	<!-- DEPENDENCIES                                                           -->
	<!-- ====================================================================== -->
	<dependencies>
		<!-- ///////////////////////////////////////// -->
		<!-- R01F: Base Provider Classes               -->
		<!-- ///////////////////////////////////////// -->
		<dependency>
			<groupId>r01.fabric.security.providers.common</groupId>
			<artifactId>r01fSecurityProviderBaseClasses</artifactId>
			<version>${revision}</version>
		</dependency>

		<!-- ///////////////////////////////////////// -->
		<!-- Open SAML                                 -->
		<!-- ///////////////////////////////////////// -->
		<dependency>
			<groupId>org.opensaml</groupId>
			<artifactId>opensaml-core</artifactId>
			<version>${opensaml.version}</version>
		</dependency>
		<dependency>
			<groupId>org.opensaml</groupId>
			<artifactId>opensaml-saml-api</artifactId>
			<version>${opensaml.version}</version>
		</dependency>
		<dependency>
			<groupId>org.opensaml</groupId>
			<artifactId>opensaml-saml-impl</artifactId>
			<version>${opensaml.version}</version>
			<exclusions>
		        <exclusion>
		           <groupId>org.apache.velocity</groupId>
		           <artifactId>velocity</artifactId>
		        </exclusion>
			</exclusions>
		</dependency>
		<!-- avoid java.security.NoSuchAlgorithmException: RIPEMD160 MessageDigest not available error -->
		<!-- add BouncyCastle dependency and call Security.addProvider(new BouncyCastleProvider()); when initializing  -->
	    <dependency>
	        <groupId>r01.fabric.security</groupId>
	        <artifactId>r01fCryptoClasses</artifactId>
	        <version>${revision}</version>
	    </dependency>

		<!-- ///////////////////////////////////////// -->
		<!-- ServletAPI                                -->
		<!-- ///////////////////////////////////////// -->
		<!-- [r01fWebProfileClasses] has SevletAPI as a dependency,
			 ... BUT it's SCOPE is PROVIDED so it has to be defined
			     here again -->
		<dependency>
		    <groupId>jakarta.servlet</groupId>
		    <artifactId>jakarta.servlet-api</artifactId>
		    <version>6.0.0</version>
		    <scope>provided</scope>		<!-- BEWARE!!! -->
		</dependency>
	</dependencies>

</project>

